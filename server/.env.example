# Copy to .env and fill in what you have. Every key is optional: without any vendor keys the
# server runs on sample prices, and each vendor you add switches its offers to live prices.

PORT=8787
# SQLite database file (created on first start, seeded with the catalog and sample prices).
DB_PATH=data/partscout.db

# Where prices are fetched for. DigiKey/Mouser/Nexar return INR prices for India when available.
COUNTRY=IN
CURRENCY=INR

# When to refresh prices (cron syntax, server time). Default: every day at 06:00.
REFRESH_CRON=0 6 * * *
# Protects POST /api/admin/refresh. Leave empty to disable the endpoint.
ADMIN_TOKEN=

# DigiKey: https://developer.digikey.com (Product Information v4, client-credentials app)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser: https://www.mouser.in/api-search/ (Search API key)
MOUSER_API_KEY=

# Nexar (Octopart): https://portal.nexar.com (Supply app). Free plans have a small monthly part quota,
# so Nexar is only used for vendors that have no direct key above (e.g. LCSC).
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
